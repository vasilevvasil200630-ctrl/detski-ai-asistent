// Схема на базата — по модела на МатураПлюс (Prisma 7 + PostgreSQL/Supabase, клиент в src/generated).
// Промяна: редактирай тук → npm run db:migrate:diff → запиши SQL в prisma/migrations/<дата>_<име>/migration.sql
// → прегледай → commit → npm run db:migrate:deploy. Не ползвай `prisma db push` срещу живата база.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Роля на учителя в своята детска градина: създателят на градината е ADMIN.
enum KgRole {
  ADMIN
  TEACHER
}

/// Учител (потребителски профил). Вход с имейл и парола (bcrypt + JWT бисквитка).
model User {
  id                        String             @id @default(cuid())
  email                     String             @unique
  passwordHash              String
  name                      String
  avatar                    String             @default("👩‍🏫")
  /// Длъжност, напр. „Старши учител“
  jobTitle                  String             @default("Учител")
  /// Възрастова група „1“…„4“ (I–IV група)
  ageGroup                  String             @default("2")
  /// Име на групата, напр. „II група „Пчелички“ (4–5 г.)“
  groupName                 String             @default("")
  kgRole                    KgRole             @default(TEACHER)
  /// Влязла е с временна парола от директора — сайтът я подканва да си сложи своя
  mustChangePassword        Boolean            @default(false)
  /// Премахната от екипа от директора: без достъп, споделеното от нея остава в градината
  removedAt                 DateTime?
  removedFromKindergartenId String?
  kindergartenId            String?
  kindergarten              Kindergarten?      @relation(fields: [kindergartenId], references: [id], onDelete: SetNull)
  bankGames                 BankGame[]
  likes                     BankGameLike[]
  materials                 Material[]
  materialLikes             MaterialLike[]
  cloudFiles                CloudFile[]
  notes                     Note[]
  showcaseItems             ShowcaseItem[]     @relation("ShowcaseAuthor")
  reviewedShowcaseItems     ShowcaseItem[]     @relation("ShowcaseReviewer")
  announcements             Announcement[]
  announcementReads         AnnouncementRead[]
  thematicPlans             ThematicPlan[]     @relation("PlanAuthor")
  approvedPlans             ThematicPlan[]     @relation("PlanApprover")
  /// Групата на учителя (директорът я задава) — за страницата на групата за родителите
  groupId                   String?
  group                     Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parentPosts               ParentPost[]       @relation("ParentPostAuthor")
  reviewedParentPosts       ParentPost[]       @relation("ParentPostReviewer")
  /// Кратко представяне на учителя за публичната витрина (по желание)
  showcaseBio               String             @default("")
  /// Таен адрес за абонамент на календара на телефона със задачите от бележника (null — изключен)
  calendarToken             String?            @unique
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([kindergartenId])
}

/// Детска градина — общото пространство на учителския екип.
model Kindergarten {
  id            String         @id @default(cuid())
  name          String
  city          String         @default("")
  motto         String         @default("")
  /// Код за присъединяване на колеги (напр. ДГ-7K4P2M)
  joinCode      String         @unique
  /// Приемане на нови учители: директорът го изключва, когато екипът е пълен (първият профил — винаги)
  teacherSignupOpen Boolean    @default(true)
  teachers      User[]
  bankGames     BankGame[]
  materials     Material[]
  cloudFiles    CloudFile[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  showcaseItems ShowcaseItem[]
  announcements Announcement[]
  thematicPlans ThematicPlan[]
  groups        Group[]
  parentPosts   ParentPost[]
}

/// (Остаряло) Игра в колективната банка — от миграция 1_teacher_library данните са копирани в Material.
/// Таблицата остава само за съхранение на старите редове; кодът ползва Material.
model BankGame {
  id             String         @id @default(cuid())
  kindergartenId String
  kindergarten   Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  ageGroup       String
  mood           String
  location       String
  resources      String
  /// Самата игра (GeneratedGame): заглавие, стих, стъпки, умения, СОП адаптация
  game           Json
  likes          BankGameLike[]
  createdAt      DateTime       @default(now())

  @@index([kindergartenId, createdAt])
  @@index([ageGroup])
}

model BankGameLike {
  userId    String
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      BankGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, gameId])
  @@index([gameId])
}

/// Вид на материала в библиотеката на учителя.
enum MaterialKind {
  /// Игра (генерирана или авторска)
  GAME
  /// План-конспект на педагогическа ситуация с приказка и бележка за родителите
  LESSON
  /// Помощен материал: стихче, гатанка, песничка, текст за табло, промпт и др.
  MATERIAL
}

/// Всичко, което учителят създаде или генерира: пази се в профила му по възрастови групи
/// и по желание се споделя с колегите от неговата детска градина.
model Material {
  id             String         @id @default(cuid())
  authorId       String?
  author         User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Градината на автора към момента на записа — в нея се вижда, ако е споделен
  kindergartenId String?
  kindergarten   Kindergarten?  @relation(fields: [kindergartenId], references: [id], onDelete: SetNull)
  kind           MaterialKind
  title          String
  /// Възрастова група „1“…„4“ (I–IV група)
  ageGroup       String
  /// Направление по Наредба № 5 (bel, math, world, art, music, construct, pe) или bdp
  direction      String?
  /// Образователно ядро (или тема по БДП)
  core           String?
  /// Празник (id от src/services/holidays.ts)
  holiday        String?
  /// Допълнителни данни, напр. филтрите на играта (настроение, място, материали)
  meta           Json?
  /// Съдържанието: GeneratedGame, GeneratedLessonPlan или { text }
  content        Json
  shared         Boolean        @default(false)
  sharedAt       DateTime?
  /// Ако е копие от материал на колега
  copiedFromId   String?
  /// „Изпитано с деца“: кога учителят е провел материала с групата и как е минало
  triedAt        DateTime?
  triedNote      String?
  likes          MaterialLike[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([authorId, ageGroup])
  @@index([kindergartenId, shared, createdAt])
  @@index([holiday])
}

/// Еднократни линкове по имейл (нова парола). По модела на МатураПлюс: пази се само SHA-256
/// на токена; `identifier` = "<цел>:<userId>".
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Вид на обратната връзка от учителите.
enum FeedbackType {
  PRAISE
  IDEA
  BUG
}

/// Обратна връзка от формата „Обратна връзка“ — пази се в базата и (ако има Resend) идва по имейл.
model Feedback {
  id        String       @id @default(cuid())
  type      FeedbackType
  rating    Int
  message   String
  email     String?
  page      String?
  /// Учителят, ако е влязъл (без релация — изтрит профил не трие обратната връзка)
  userId    String?
  createdAt DateTime     @default(now())

  @@index([createdAt])
}

model MaterialLike {
  userId     String
  materialId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, materialId])
  @@index([materialId])
}

/// Файл в общия облак на детската градина: качен от учител или от директора.
/// `shared` = вижда се от всички учители в градината; иначе е само в личните файлове на качилия.
model CloudFile {
  id             String         @id @default(cuid())
  kindergartenId String
  kindergarten   Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  uploaderId     String?
  uploader       User?          @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  title          String
  description    String         @default("")
  /// Папка (id от src/lib/cloud/folders.ts), напр. "plans", "holidays", "documents"
  folder         String         @default("other")
  /// Възрастова група „1“…„4“ или null = за всички групи
  ageGroup       String?
  /// Направление по Наредба № 5 или bdp
  direction      String?
  /// Оригиналното име на файла (за свалянето)
  fileName       String
  mimeType       String
  /// Размер в байтове
  size           Int
  /// Къде е съдържанието: "blob" (частно хранилище на Vercel Blob) или "db" (CloudFileData)
  storage        String
  blobPathname   String?        @unique
  shared         Boolean        @default(true)
  downloads      Int            @default(0)
  data           CloudFileData?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([kindergartenId, shared, createdAt])
  @@index([uploaderId, createdAt])
}

/// Съдържанието на малък файл, когато няма Vercel Blob (локално или преди хранилището да е свързано).
model CloudFileData {
  fileId String    @id
  file   CloudFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  bytes  Bytes
}

/// Бележка в личния бележник на учителя — вижда я само той.
model Note {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("")
  body      String    @default("")
  /// Цвят на листчето: yellow, blue, green, pink, violet
  color     String    @default("yellow")
  pinned    Boolean   @default(false)
  /// Дата за напомняне/срок (само дата) — тогава бележката е и задача
  dueDate   DateTime?
  done      Boolean   @default(false)
  /// Час на задачата „ЧЧ:ММ“ (по желание)
  dueTime   String?
  /// Напомняне: колко дни преди срока (0 — в деня); null — без напомняне
  remindDays Int?
  /// „Утре пак“: напомнянето се показва отново от този ден
  snoozedUntil DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, done, dueDate])
}

/// Състояние на дейност за публичната витрина: учителят предлага, директорът одобрява.
enum ShowcaseStatus {
  PENDING
  APPROVED
  RETURNED
}

/// Дейност на публичната витрина за родителите: копие на материала към момента на предлагането,
/// разказ какво са правили децата и снимки без деца (от облака на учителя). Вижда се публично само
/// след одобрение от директора и докато авторът е в екипа на градината.
model ShowcaseItem {
  id             String         @id @default(cuid())
  kindergartenId String
  kindergarten   Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  authorId       String
  author         User           @relation("ShowcaseAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// Материалът, от който е предложена (само за справка; показва се копието в content)
  materialId     String?
  kind           MaterialKind
  title          String
  /// „Какво направихме с децата“
  story          String
  ageGroup       String
  direction      String?
  holiday        String?
  /// Копие на съдържанието (игра с материалите, план-конспект или материал за печат)
  content        Json
  /// Снимки без деца: id на файлове от облака на автора
  imageIds       String[]       @default([])
  /// Родителите могат да отпечатат играта и листовете
  allowPrint     Boolean        @default(true)
  status         ShowcaseStatus @default(PENDING)
  /// Бележка от директора при връщане
  reviewNote     String?
  reviewedById   String?
  reviewedBy     User?          @relation("ShowcaseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([kindergartenId, status, publishedAt])
  @@index([authorId, createdAt])
}

/// Обява от директора към екипа (напр. педагогически съвет, срок за документи, празник).
model Announcement {
  id             String             @id @default(cuid())
  kindergartenId String
  kindergarten   Kindergarten       @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title          String
  body           String
  /// „Важно“ — учителите потвърждават, че са прочели
  important      Boolean            @default(false)
  /// Закачена най-горе
  pinned         Boolean            @default(false)
  /// Дата на събитието или срока (по желание)
  eventDate      DateTime?
  reads          AnnouncementRead[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([kindergartenId, createdAt])
}

/// Кой учител е прочел обявата и кога.
model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
  @@index([userId])
}

/// Тематично разпределение на група за учебната година (чл. 29, ал. 4, т. 3 и чл. 30 от Наредба № 5):
/// учебните седмици от 15 септември до 31 май с темата и ситуациите по направления.
model ThematicPlan {
  id             String         @id @default(cuid())
  kindergartenId String
  kindergarten   Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?          @relation("PlanAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  ageGroup       String
  groupName      String         @default("")
  /// Годината, в която започва учебната година (2026 → 2026/2027)
  schoolYear     Int
  /// Колегите от градината могат да го видят и да си направят копие
  shared         Boolean        @default(true)
  /// Темата на седмицата се вижда на страницата на групата (само ако разпределението е утвърдено)
  showToParents  Boolean        @default(false)
  /// Утвърдено от директора (чл. 23, ал. 4)
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?          @relation("PlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  weeks          ThematicWeek[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([authorId, ageGroup, schoolYear])
  @@index([kindergartenId, schoolYear])
}

/// Една учебна седмица от разпределението: тема и педагогически ситуации по направления.
model ThematicWeek {
  id         String       @id @default(cuid())
  planId     String
  plan       ThematicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  week       Int
  startDate  DateTime
  endDate    DateTime
  theme      String       @default("")
  notes      String       @default("")
  /// [{ direction, core, topic, results: [очаквани резултати] }]
  situations Json         @default("[]")

  @@unique([planId, week])
}

/// Група в детската градина (напр. II група „Пчелички“): директорът я създава и слага учителите в нея.
/// Има публична страница за родителите с одобреното от директора.
model Group {
  id             String       @id @default(cuid())
  kindergartenId String
  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  /// Името без възрастта, напр. „Пчелички“
  name           String
  /// Възрастова група „1“…„4“
  ageGroup       String
  /// Адресът на страницата: /grupi/<slug>
  slug           String
  sortOrder      Int          @default(0)
  teachers       User[]
  parentPosts    ParentPost[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([kindergartenId, slug])
}

/// Вид публикация за родителите.
enum ParentPostKind {
  /// Обява (събитие, среща, напомняне)
  NOTICE
  /// Покана или писмо до родителите
  LETTER
  /// Стихче или песен, които учим (за вкъщи по желание)
  VERSES
}

/// Публикация за родителите на страницата на групата (или на цялата градина, ако groupId е празно).
/// Учителят я предлага, директорът одобрява (публикациите на директора се одобряват веднага);
/// вижда се публично само когато е одобрена и авторът е в екипа.
model ParentPost {
  id             String         @id @default(cuid())
  kindergartenId String
  kindergarten   Kindergarten   @relation(fields: [kindergartenId], references: [id], onDelete: Cascade)
  /// Празно — за цялата градина (началната страница за родителите)
  groupId        String?
  group          Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  authorId       String
  author         User           @relation("ParentPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  kind           ParentPostKind
  title          String
  /// Текстът (за писмата и стихчетата — копие на материала към момента на предлагането)
  body           String
  /// Материалът за печат, ако е от „Материали за печат“ (писмо или стихчета) — за хубав печат
  printable      Json?
  /// Дата на събитието (за обявите и поканите), ако има
  eventDate      DateTime?
  status         ShowcaseStatus @default(PENDING)
  reviewNote     String?
  reviewedById   String?
  reviewedBy     User?          @relation("ParentPostReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([kindergartenId, status])
  @@index([groupId, status])
  @@index([authorId])
}
