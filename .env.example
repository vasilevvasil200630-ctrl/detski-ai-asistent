# Копирай в .env.local и попълни. Във Vercel същите имена се задават в
# Settings → Environment Variables (Production и Preview).
#
# [ЗАДЪЛЖИТЕЛНА] — без нея входът и колективната банка не работят.
# [ПРЕПОРЪЧИТЕЛНА] — без нея сайтът работи, но нещо е изключено или по-слабо.

# [ЗАДЪЛЖИТЕЛНА] Postgres (Prisma). За Supabase: Project → Connect → Transaction pooler (порт 6543).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# [САМО ЗА МИГРАЦИИ, локално] Supabase Session pooler / Direct connection (порт 5432).
# Ползва се само от npm run db:migrate:*; във Vercel не е нужна.
# DIRECT_URL="postgresql://postgres.xxx:password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# По желание: таван на връзките на инстанция. Локално с `npm run db:dev` (PGlite) сложи "1".
# DATABASE_POOL_MAX="1"

# [ЗАДЪЛЖИТЕЛНА] Подпис на сесийната бисквитка. Минимум 32 символа.
# Генерирай: openssl rand -base64 32
SESSION_SECRET="смени-ме-с-32-символен-random-string"

# [ПРЕПОРЪЧИТЕЛНА] Google Gemini — истинската AI генерация. Без него работи демо двигателят.
# Ключ от https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# [ПРЕПОРЪЧИТЕЛНА] Upstash Redis — общ лимит на заявките за всички сървърни инстанции.
# Без тях лимитът се брои в паметта на всяка инстанция.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# [ПРЕПОРЪЧИТЕЛНА] Resend — писмо с линк за нова парола и известие за обратна връзка.
# Без него страницата „Забравена парола“ казва, че писмата още не са включени.
# В production писмата тръгват само след потвърден домейн в Resend (RESEND_DOMAIN_VERIFIED="true").
RESEND_API_KEY=""
# EMAIL_FROM="Детски асистент <noreply@вашият-домейн.bg>"
# RESEND_DOMAIN_VERIFIED="true"
# ADMIN_NOTIFICATION_EMAIL="..."   # къде идва обратната връзка
# NEXT_PUBLIC_SUPPORT_EMAIL="..."  # публичен адрес за помощ (Поверителност, Условия)
# NEXT_PUBLIC_APP_URL="https://..." # собствен домейн, ако има (линкове в писмата, sitemap)
